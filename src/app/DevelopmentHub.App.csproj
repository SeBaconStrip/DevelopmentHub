<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DevelopmentHub</AssemblyName>
    <RootNamespace>DevelopmentHub.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>DeveloperHubIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Required to resolve ASP.NET Core types from the referenced backend project -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\api\DevelopmentHub.Api.csproj" />
  </ItemGroup>

  <!-- Copy backend appsettings so Kestrel can read them from the app's base dir -->
  <ItemGroup>
    <Content Include="DeveloperHubIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\api\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>appsettings.json</Link>
    </Content>
    <Content Include="..\api\appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>appsettings.Production.json</Link>
    </Content>
  </ItemGroup>

  <!-- On publish: build the React app, then copy dist/ → wwwroot/ -->
  <Target Name="BuildFrontend" BeforeTargets="Publish">
    <Exec Command="npm run build" WorkingDirectory="..\web" />
  </Target>

  <Target Name="CopyFrontendDist" AfterTargets="Publish">
    <ItemGroup>
      <FrontendFiles Include="..\web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)"
          DestinationFiles="@(FrontendFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>

