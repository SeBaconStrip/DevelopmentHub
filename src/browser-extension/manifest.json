{
  "manifest_version": 3,
  "name": "DevelopmentHub Tab Reuser",
  "version": "0.1.0",
  "description": "Focus an existing Edge tab for a URL or open a new one.",
  "permissions": ["tabs", "alarms"],
  "host_permissions": [
    "http://localhost:7131/*",
    "http://localhost:7631/*",
    "ws://localhost:7131/*",
    "ws://localhost:7631/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "DevelopmentHub Tab Reuser",
    "default_popup": "popup.html"
  }
}
