{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:screenshot": "vite build --mode screenshot",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:screenshot": "vite preview --port 5174 --mode screenshot",
