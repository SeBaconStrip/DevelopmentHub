{
  "id": "com.example.hello-plugin",
  "version": "1.0.0",
  "name": "Hello Plugin",
  "description": "Example plugin demonstrating widgets and pages.",
  "minHostVersion": "0.10.0",
  "backend": {
    "assembly": "backend-dist/ExamplePlugin.Backend.dll",
    "enabled": true
  },
  "frontend": {
    "bundle": "ui/index.js",
    "enabled": true,
    "sdkVersion": "1"
  },
  "contributes": {
    "widgets": [
      {
        "id": "com.example.hello-plugin.hello-widget",
        "label": "Hello Plugin",
        "icon": "👋",
        "defaultLayout": { "w": 4, "h": 6 }
      }
    ],
    "routes": [
      {
        "path": "/plugins/hello",
        "navLabel": "Hello Plugin",
        "navOrder": 100
      }
    ]
  }
}
