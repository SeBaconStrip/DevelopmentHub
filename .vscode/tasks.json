{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run frontend",
      "type": "shell",
      "command": "npm run build; npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/src/web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "run backend",
      "type": "shell",
      "command": "dotnet build; dotnet run --launch-profile http",
      "options": {
        "cwd": "${workspaceFolder}/src/api"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run app",
      "type": "shell",
      "command": "dotnet build; dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/src/app",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "app"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run all",
      "dependsOn": ["run frontend", "run app"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "publish app",
      "type": "shell",
      "command": "dotnet publish -c Release -r win-x64 --self-contained true -o ../../publish",
      "options": {
        "cwd": "${workspaceFolder}/src/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build installer",
      "type": "shell",
      "command": "$version = (Get-Content '../version.txt').Trim() + '.0-localbuild'; & (Join-Path $env:LOCALAPPDATA 'Programs\\Inno Setup 6\\ISCC.exe') \"/DMyAppVersion=$version\" DevelopmentHub.iss",
      "options": {
        "cwd": "${workspaceFolder}/installer"
      },
      "dependsOn": ["publish app"],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "open current log",
      "type": "shell",
      "command": "$logDir = Join-Path $env:LOCALAPPDATA 'DevelopmentHub\\logs'; $logFile = Join-Path $logDir ('app-' + (Get-Date).ToString('yyyyMMdd') + '.log'); if (-not (Test-Path $logDir)) { New-Item -ItemType Directory -Path $logDir | Out-Null }; if (-not (Test-Path $logFile)) { New-Item -ItemType File -Path $logFile | Out-Null }; Start-Process $logFile",
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
